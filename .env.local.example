# 인스타그램 연동 (Instagram Graph API – Business Discovery)
# 이 파일을 복사해 .env.local 로 만들고 값을 채우세요. (.env.local 은 커밋 금지)
# 로컬에서 `npm run fetch:instagram` 또는 `npm run build` 시 data/instagram.json 에 수집됩니다.

# 내 인스타그램 "비즈니스/크리에이터" 계정의 장기 액세스 토큰
IG_ACCESS_TOKEN=

# 내 인스타그램 사용자 ID (Graph API user id)
IG_USER_ID=

# 수집 대상 공개 계정 (비즈니스/크리에이터 계정이어야 Business Discovery 가능)
IG_TARGET_USERNAME=i_love_sokcho

# 맛집 실제 사진 (Google Places API) — 빌드 시점에 등록 사진을 내려받아 노출
# Google Cloud Console에서 Places API 사용 설정 후 키 발급
GOOGLE_MAPS_API_KEY=
